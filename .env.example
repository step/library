# For running `npm run dev` on your machine against the containerised database
# (start just the database with: docker compose up -d postgres neon-proxy).
# Copy to .env.local; it takes priority over .env.
# The host must be db.localtest.me (resolves to 127.0.0.1): src/app/lib/neon-local.ts keys off it.
# The port is the host port of the postgres container (see docker-compose.yml).
DATABASE_URL=postgres://library:library@db.localtest.me:5433/library
