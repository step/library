{
  "name": "step-library",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "vitest run",
    "test:watch": "vitest",
    "analyze": "ANALYZE=true npm run build",
    "analyze:server": "BUNDLE_ANALYZE=server npm run build",
    "analyze:browser": "BUNDLE_ANALYZE=browser npm run build",
    "db:generate": "node --env-file=.env node_modules/.bin/drizzle-kit generate",
    "db:migrate": "node --env-file=.env node_modules/.bin/drizzle-kit migrate",
    "db:pull": "node --env-file=.env node_modules/.bin/drizzle-kit pull",
    "db:migrate:local": "node --env-file=.env.local node_modules/.bin/drizzle-kit migrate",
    "docker:up": "docker compose up --build",
    "docker:down": "docker compose down",
    "docker:reset": "docker compose down -v"
  },
  "dependencies": {
    "@auth/neon-adapter": "^1.10.0",
    "@neondatabase/serverless": "^1.0.1",
    "@yudiel/react-qr-scanner": "^2.3.1",
    "drizzle-orm": "^0.45.4",
    "lucide-react": "^0.525.0",
    "next": "^16.2.7",
    "next-auth": "^4.24.14",
    "next-pwa": "^2.0.2",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-virtuoso": "^4.13.0",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@next/bundle-analyzer": "^15.4.6",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.3.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "15.3.5",
    "jsdom": "^31.0.0",
    "pg": "^8.23.1",
    "typescript": "^5",
    "vitest": "^3.2.7"
  }
}
